generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           Int       @id @default(autoincrement())
  user         String    @unique
  password     String
  phone        String?
  email        String?
  role         Role      @default(USER)
  dateCreation DateTime? @default(now())
}

enum Role {
  USER
  ADMIN
}
