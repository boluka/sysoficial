generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           Int       @id @default(autoincrement())
  name         String?
  user         String    @unique
  password     String
  phone        String?
  email        String?
  role         Role      @default(USER)
  dateCreation DateTime? @default(now())
}

model RelatorioDoDia {
  id              String           @id @default(uuid())
  data            String           @unique
  formRecebimento FormRecebimento?
  formArmamento FormArmamento?
  formEquipe FormEquipe?
}

model FormRecebimento {
  id            String         @id @default(uuid())
  plantao       String
  chefeReceb    String
  chefeEntrega  String
  chefeAuxiliar String
  efetivoCarc   Int
  transitoCarc  Int
  mat_carga     String
  mat_belico    String
  relatorioId   String         @unique
  relatorio     RelatorioDoDia @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
}

model FormArmamento {
  id  Int  @default(autoincrement())
  armamento   Json
  municao   Int
  qtPistola Int
  qtCarabinaQuinze Int
  qtCarabinaTrinta Int
  relatorioId String @unique
  relatorio RelatorioDoDia @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
}

model FormEquipe {
  id Int  @id @default(autoincrement())
  chefeEquipe String 
  auxChefe String
  portariaPrinc String
  auxPort1 String?
  auxPort2 String?
  passarelaPrinc String?
  escolaPadaria String?
  trabalhoCrina String?
  responsavelPv1 String
  corredorPv1 Json?
  responsavelPv2 String
  corredorPv2 Json?
  relatorioId String @unique
  relatorio RelatorioDoDia @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
}

model Person {
  id Int @id @default(autoincrement())
  name String
}

model Armamento {
  id     Int      @id @default(autoincrement())
  num    String   @unique
  tipo   String
  calibre  String
}

enum Role {
  USER
  ADMIN
}
